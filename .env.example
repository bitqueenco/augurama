# Local account setup: dreamina-director invite --label Owner
DD_ENV=development
# Bind/port are CLI flags: dreamina-director serve --host 127.0.0.1 --port 8765
DD_BASE_URL=http://127.0.0.1:8765
DD_DATA_DIR=.director
# Production: dedicated HTTPS service + persistent volume, not ephemeral serverless SQLite.
# DD_ENV=production
# DD_BASE_URL=https://YOUR_OWN_SERVICE_HOST
# DD_WIDGET_ORIGIN=https://YOUR_OWN_WIDGET_HOST
# DD_ENCRYPTION_KEY=<base64url 32 random bytes; generate with dreamina-director keygen>
# DD_PUBLIC_CONTACT=<real support address, required by release readiness check>
# DD_LEGAL_APPROVED=1
# Account-specific BytePlus keys are entered in the secure web account page.
# They are never requested by the chat tool or included in a plugin package.
DD_MAX_ESTIMATED_USD_PER_JOB=10
DD_DAILY_GENERATION_LIMIT=20
DD_RETENTION_DAYS=30
# DCR accepts only exact registered redirect URIs from this list, plus native loopback callbacks.
# The callback-ID-specific ChatGPT redirect must be added exactly as shown in its portal.
DD_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect,https://antigravity.google/oauth-callback

# The exact public domain-verification challenge token returned by the OpenAI portal.
# Do not invent it or reuse/overwrite another plugin's challenge.
# DD_OPENAI_CHALLENGE_TOKEN=
